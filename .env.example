# MongoDB Atlas connection string
# Replace with your actual MongoDB Atlas connection string
# Get this from: MongoDB Atlas > Connect > Connect your application
MONGODB_URI=your_mongodb_uri_here
# Optional: specific database name
EMAIL_USER=your_email_user_here
EMAIL_PASS=your_email_password_here

MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_template_id_here

NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXX

# Google Places API config for Google Reviews
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
GOOGLE_PLACE_ID=your_google_place_id_here

# Razorpay Default Config (Live/Production for main website trips)
RAZORPAY_KEY_ID=rzp_live_xxxxxx
RAZORPAY_KEY_SECRET=xxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxx

# Razorpay Dedicated Itinerary Template Test Config (Only applies to Itinerary bookings)
RAZORPAY_ITINERARY_KEY_ID=rzp_test_xxxxxx
RAZORPAY_ITINERARY_KEY_SECRET=xxxxxx
NEXT_PUBLIC_RAZORPAY_ITINERARY_KEY_ID=rzp_test_xxxxxx